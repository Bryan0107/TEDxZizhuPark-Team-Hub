# 飞书集成环境变量示例（复制到 .env.local 或配置到 Vercel）
# 真实密钥不要提交到 Git：*.env 已在 .gitignore 中忽略。

# ── 飞书自建应用凭据（仅服务端） ──────────────────
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 事件订阅：Verification Token 与 Encrypt Key（飞书开放平台 → 事件与回调）
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# OAuth 回调地址，必须与飞书后台「安全设置 → 重定向 URL」完全一致
FEISHU_REDIRECT_URI=https://your-domain/api/feishu/oauth/callback

# 默认通知目标群 chat_id
FEISHU_NOTIFICATION_CHAT_ID=

# 自动同步间隔（分钟）
FEISHU_SYNC_INTERVAL=30

# ── Team Hub 服务端 ─────────────────────────────
# Appwrite 服务端 API Key（Databases / Tables 读写 + 用户读取）
APPWRITE_KEY=
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6af1211f00086491c07c
APPWRITE_DB=tedx_team_hub

# 会话签名密钥（HS256），任意 32+ 位随机字符串
TEAM_HUB_SESSION_SECRET=

# 定时同步鉴权：请求头 x-cron-secret 或 Authorization: Bearer
FEISHU_CRON_SECRET=
